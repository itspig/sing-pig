{
	"log": {
		"disabled": false,
		"level": "info",
		"timestamp": true
	},
	"ntp": {
		"enabled": true,
		"server": "time.cloudflare.com",
		"interval": "1d"
	},
	"certificate": {
		"store": "chrome"
	},
	"http_clients": [{
		"tag": "🕷️Http_client",
		"engine": "go",
		"version": 2
	}],
	"dns": {
		"servers": [{
			"type": "local",
			"tag": "🔎LocalDNS"
		},
		{
			"type": "tls",
			"tag": "🔎Google",
			"server": "dns.google",
			"domain_resolver": {
				"server": "🔎LocalDNS",
				"strategy": "ipv4_only"
			}
		},
		{
			"type": "https",
			"tag": "🔎NextDNS",
			"server": "dns.nextdns.io",
			"path": "/1fffaa/FR",
			"domain_resolver": {
				"server": "🔎LocalDNS",
				"strategy": "ipv4_only"
			}
		}]
	},
	"inbounds": [{
		"type": "trojan",
		"tag": "Horse",
		"listen": "::",
		"listen_port": 8181,
		"users": [{
			"name": "pig",
			"password": "*"
		}],
		"transport": {
			"type": "ws",
			"path": "/api/v3/download.getFile",
			"early_data_header_name": "Sec-WebSocket-Protocol"
		}
	}],
	"outbounds": [{
		"type": "direct",
		"tag": "✈️Direct"
	}],
	"route": {
		"default_domain_resolver": {
			"server": "🔎NextDNS",
			"strategy": "ipv4_only"
		},
		"default_http_client": "🕷️Http_client",
		"rules": [{
			"ip_is_private": true,
			"action": "reject"
		}],
		"final": "✈️Direct"
	}
}